# Copy to .env next to compose.yaml and fill in.

# Port of the web interface on the server. Required.
XPR_UI_PORT=20800

# Absolute path of the folder on the server for the settings (settings.sqlite3).
# Required. It is mounted at the same path in the container.
XPR_DATA_DIR=/srv/x-proxy-router

# IP address of the web interface; 0.0.0.0 (all IPv4 addresses of the server) when not set.
# 127.0.0.1 opens it only on the server itself, e.g. through an SSH tunnel.
#XPR_UI_HOST=0.0.0.0
