# Two DNS names under the same parent domain, both pointing to this server.
# The panel and login use HTTPS 8443; TCP 443 is reserved for VLESS REALITY.
XPR_PANEL_DOMAIN=panel.example.com
XPR_AUTH_DOMAIN=auth.example.com
XPR_DATA_DIR=/srv/x-proxy-router

# Generate interactively, without "format for Docker", and paste between single quotes.
# docker run --rm -it ghcr.io/tinyauthapp/tinyauth:v5 user create --interactive
# Single quotes in this .env file preserve the literal $ in the bcrypt hash.
TINYAUTH_USERS=''
